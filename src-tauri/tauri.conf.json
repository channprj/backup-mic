{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJI Mic Backup",
  "version": "0.260810.5",
  "identifier": "com.channprj.DJIMicBackup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DJI Mic Backup",
        "width": 380,
        "height": 640,
        "minWidth": 380,
        "maxWidth": 380,
        "minHeight": 320,
        "maxHeight": 640,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "DJI Mic Backup 설정",
        "url": "index.html?window=settings",
        "width": 540,
        "height": 620,
        "minWidth": 480,
        "minHeight": 520,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
